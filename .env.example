OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

DADATA_API_KEY=

# Local mode keeps manual cards in Excel. Use memory on Render/cloud for Bitrix jobs.
APP_STORAGE_MODE=excel

# Bitrix24 integration. Store these as Render Environment Variables in production.
BITRIX_WEBHOOK_URL=
BITRIX_INBOUND_TOKEN=

# Optional. Absolute path to LibreOffice/soffice for PPTX -> PDF conversion.
PPTX_TO_PDF_CONVERTER=

# Optional. iLoveAPI/iLovePDF external conversion fallback.
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_REGION=eu

# Optional. Override fonts used for direct PDF-template rendering.
PDF_TEMPLATE_FONT=
PDF_TEMPLATE_BOLD_FONT=
